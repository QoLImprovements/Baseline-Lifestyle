{
  "formatVersion": 1,
  "authority": "SQLite is the current migration source; protected Saved Data resource files are the target production authority",
  "canonicalGameFiles": {
    "ninja": "baseline-realm.json",
    "baseline-realm": "baseline-realm.json",
    "pairs": "pairs.json",
    "detectword": "detect-word.json",
    "detect-word": "detect-word.json",
    "make24": "make-24.json",
    "make-24": "make-24.json",
    "trackcoin": "track-coin.json",
    "track-coin": "track-coin.json",
    "ruleshift": "rule-shift.json",
    "rule-shift": "rule-shift.json",
    "dartsfocused": "darts-focused.json",
    "darts-focused": "darts-focused.json",
    "meridiangrove": "meridian-grove.json",
    "meridian-grove": "meridian-grove.json"
  },
  "rules": [
    {
      "id": "badminton-shared-v3-legacy",
      "inventoryPatterns": [
        "__baseline_badminton_session_v3__"
      ],
      "knownKeys": [
        "__baseline_badminton_session_v3__"
      ],
      "classification": "legacy-shared-state",
      "decision": "normalise-and-compare",
      "target": "Shared/Badminton/badminton.json",
      "cutoverRule": "Import only through the protected Badminton administrator path. Compare with the current server state and never let a browser copy silently overwrite a newer shared revision."
    },
    {
      "id": "badminton-shared-v4-cache",
      "inventoryPatterns": [
        "__baseline_badminton_session_v4__"
      ],
      "knownKeys": [
        "__baseline_badminton_session_v4__"
      ],
      "classification": "shared-state-browser-cache",
      "decision": "retain-as-non-authoritative-cache-until-cutover",
      "target": "Shared/Badminton/badminton.json",
      "cutoverRule": "The protected shared Badminton resource is authoritative after cutover. Clear or refresh the local cache only after a verified server load and enforce established Badminton administration permissions."
    },
    {
      "id": "diet-log-local-content",
      "inventoryPatterns": [
        "__baseline_food_diet_log_v1__"
      ],
      "knownKeys": [
        "__baseline_food_diet_log_v1__"
      ],
      "classification": "user-content-without-approved-resource",
      "decision": "preserve-local-and-block-retirement",
      "target": null,
      "cutoverRule": "Contains dated food logs, notes, recipes and health-profile fields. Do not delete or force it into fitness.json. A dedicated schema and explicit approval are required first."
    },
    {
      "id": "outer-embed-snapshot",
      "inventoryPatterns": [
        "__baseline_outer_embed_snapshot_v2__"
      ],
      "knownKeys": [
        "__baseline_outer_embed_snapshot_v2__"
      ],
      "classification": "ephemeral-navigation-snapshot",
      "decision": "retire-without-migration",
      "target": null,
      "cutoverRule": "Deletion-only compatibility state. It is not user content and must not become permanent Saved Data."
    },
    {
      "id": "voice-settings",
      "inventoryPatterns": [
        "__baseline_voice_settings_v1__"
      ],
      "knownKeys": [
        "__baseline_voice_settings_v1__"
      ],
      "classification": "user-settings",
      "decision": "migrate-authenticated-value",
      "target": "Users/{paddedUserId}/voice.json",
      "cutoverRule": "Use the authenticated server voice_settings record when present. Keep guest settings local and never let guest data overwrite an authenticated resource."
    },
    {
      "id": "badminton-focused-game",
      "inventoryPatterns": [
        "__bl_badminton_focused_v1__"
      ],
      "knownKeys": [
        "__bl_badminton_focused_v1__"
      ],
      "classification": "unapproved-individual-game-save",
      "decision": "preserve-local-and-block-retirement",
      "target": null,
      "cutoverRule": "This browser save is not recognised by the current protected Games API or canonical game-file map. Preserve it unchanged until a dedicated game schema and physical filename are explicitly approved; never discard or merge it into shared Badminton state."
    },
    {
      "id": "darts-focused-game",
      "inventoryPatterns": [
        "__bl_darts_focused_v1__",
        "__bl_darts_focused_v2__"
      ],
      "knownKeys": [
        "__bl_darts_focused_v1__",
        "__bl_darts_focused_v2__"
      ],
      "classification": "individual-game-save-with-duplicate-legacy-key",
      "decision": "normalise-and-migrate-explicitly",
      "target": "Users/{paddedUserId}/Games/darts-focused.json",
      "cutoverRule": "Treat v1 as the current primary and v2 as the compatibility copy. Report a conflict if their payloads differ; do not choose silently."
    },
    {
      "id": "games-auto-next-preference",
      "inventoryPatterns": [
        "__bl_games_auto_next_v1__"
      ],
      "knownKeys": [
        "__bl_games_auto_next_v1__"
      ],
      "classification": "device-ui-preference",
      "decision": "keep-local",
      "target": null,
      "cutoverRule": "This controls device-specific automatic round progression and is not account progression."
    },
    {
      "id": "games-guest-profiles",
      "inventoryPatterns": [
        "__bl_games_guest_profiles_v1__"
      ],
      "knownKeys": [
        "__bl_games_guest_profiles_v1__"
      ],
      "classification": "guest-game-profiles",
      "decision": "offer-explicit-per-game-import",
      "target": "Users/{paddedUserId}/Games/{canonicalGameFile}",
      "cutoverRule": "Split by recognised game ID using canonicalGameFiles. Require a signed-in user decision and stale-write comparison; guest data must never automatically replace authenticated progress."
    },
    {
      "id": "trackcoin-game",
      "inventoryPatterns": [
        "__bl_trackcoin_v1__"
      ],
      "knownKeys": [
        "__bl_trackcoin_v1__"
      ],
      "classification": "individual-game-save",
      "decision": "migrate-explicitly",
      "target": "Users/{paddedUserId}/Games/track-coin.json",
      "cutoverRule": "Prefer an existing authenticated Games Hub profile. Import local data only after recognised-resource validation, revision comparison and conflict review."
    },
    {
      "id": "recipe-title-index",
      "inventoryPatterns": [
        "[expression] 'bl_recipe_index_' + appKey"
      ],
      "knownKeys": [
        "bl_recipe_index_{app}"
      ],
      "classification": "rebuildable-display-cache",
      "decision": "rebuild-without-migration",
      "target": null,
      "cutoverRule": "Recipe titles are regenerated from page content and are not the favourites authority."
    },
    {
      "id": "fitness-body-profile",
      "inventoryPatterns": [
        "[expression] bodyProfileKey(",
        "[expression] bodyKey("
      ],
      "knownKeys": [
        "__bl_fitness_body_profile_v1__::{normalised-user}"
      ],
      "classification": "fitness-user-data",
      "decision": "migrate-after-schema-validation",
      "target": "Users/{paddedUserId}/fitness.json#profile",
      "cutoverRule": "Validate field allowlists and units. Do not create paths from the username embedded in the legacy key. The bridge expression and the Fitness application expression refer to the same physical browser key."
    },
    {
      "id": "storage-wrapper-implementation",
      "inventoryPatterns": [
        "[expression] key"
      ],
      "knownKeys": [],
      "classification": "implementation-only",
      "decision": "no-independent-migration",
      "target": null,
      "cutoverRule": "Generic wrapper calls are accounted for by the concrete keys passed into them."
    },
    {
      "id": "realm-exploration-game",
      "inventoryPatterns": [
        "[expression] SAVE_KEY"
      ],
      "knownKeys": [
        "baseline.realm.exploration.jrpg.v1"
      ],
      "classification": "baseline-realm-mode-save",
      "decision": "normalise-into-baseline-realm-resource",
      "target": "Users/{paddedUserId}/Games/baseline-realm.json#exploration",
      "cutoverRule": "Validate the JRPG save version and shared-inventory interactions, then merge it into the single Baseline Realm resource without overwriting newer Realm sections."
    },
    {
      "id": "skincare-slider-settings",
      "inventoryPatterns": [
        "[expression] sliderSaveStorageKey(saveId",
        "[expression] sliderSaveStorageKey(saveKey"
      ],
      "knownKeys": [
        "__baseline_slider_state__::{normalised-user}::{recipe-or-variant}"
      ],
      "classification": "user-settings-without-approved-resource",
      "decision": "preserve-local-and-block-retirement",
      "target": null,
      "cutoverRule": "These are authenticated recipe-controller preferences, but the approved Saved Data tree has no skincare resource. Keep them local until a protected schema is separately approved."
    },
    {
      "id": "fitness-active-workout",
      "inventoryPatterns": [
        "[expression] stepStorageKey(current.planId",
        "[expression] nextKey",
        "[expression] stepKey(context.planId"
      ],
      "knownKeys": [
        "__bl_fitness_workout_progress_v2__::{planId}::{sessionIndex}::{normalised-user}"
      ],
      "classification": "fitness-active-session-state",
      "decision": "migrate-only-valid-current-session",
      "target": "Users/{paddedUserId}/fitness.json#activeWorkout",
      "cutoverRule": "Import only when plan ID, next session and step count match authoritative Fitness data. Invalid or stale entries must be reported, not silently applied."
    },
    {
      "id": "fitness-bridge-plan-lookups",
      "inventoryPatterns": [
        "{dynamic}{dynamic}"
      ],
      "knownKeys": [
        "__bl_fitness_plan_cache_v1__::{normalised-user}",
        "__bl_fitness_plan_v1__::{normalised-user}"
      ],
      "classification": "fitness-bridge-lookup-expressions",
      "decision": "no-independent-migration",
      "target": null,
      "cutoverRule": "These dynamic bridge lookups read the already-reviewed Fitness server cache and file-protocol fallback keys. They create no additional browser resource and inherit the separate cache and fallback decisions."
    },
    {
      "id": "fitness-plan-cache",
      "inventoryPatterns": [
        "[expression] userCacheKey("
      ],
      "knownKeys": [
        "__bl_fitness_plan_cache_v1__::{normalised-user}"
      ],
      "classification": "rebuildable-server-cache",
      "decision": "rebuild-without-migration",
      "target": null,
      "cutoverRule": "The server plan is authoritative during migration; this cache may only accelerate display and must be replaced after a verified authoritative read."
    },
    {
      "id": "fitness-file-protocol-plan",
      "inventoryPatterns": [
        "[expression] userPlanKey("
      ],
      "knownKeys": [
        "__bl_fitness_plan_v1__::{normalised-user}"
      ],
      "classification": "file-protocol-development-fallback",
      "decision": "exclude-from-production-migration",
      "target": null,
      "cutoverRule": "Production uses the protected Fitness API. This fallback must not compete with SQLite during migration or the Saved Data resource after cutover."
    },
    {
      "id": "realm-tactical-v1-legacy",
      "inventoryPatterns": [
        "baseline-realm:tactical-operations:v1"
      ],
      "knownKeys": [
        "baseline-realm:tactical-operations:v1"
      ],
      "classification": "legacy-baseline-realm-mode-save",
      "decision": "normalise-then-retire",
      "target": "Users/{paddedUserId}/Games/baseline-realm.json#tacticalOperations",
      "cutoverRule": "Use only when no valid newer v2 or inventory-service state exists. Merge into the single Baseline Realm resource and remove the legacy key only after verified import."
    },
    {
      "id": "realm-tactical-v2",
      "inventoryPatterns": [
        "baseline-realm:tactical-operations:v2"
      ],
      "knownKeys": [
        "baseline-realm:tactical-operations:v2"
      ],
      "classification": "baseline-realm-mode-save-and-local-fallback",
      "decision": "normalise-into-baseline-realm-resource",
      "target": "Users/{paddedUserId}/Games/baseline-realm.json#tacticalOperations",
      "cutoverRule": "Compare with the Baseline Realm inventory-service copy and report divergence before merging the selected state into the single Baseline Realm resource."
    },
    {
      "id": "games-hub-view",
      "inventoryPatterns": [
        "baselineGamesHubView"
      ],
      "knownKeys": [
        "baselineGamesHubView"
      ],
      "classification": "device-ui-state",
      "decision": "keep-local-or-session-only",
      "target": null,
      "cutoverRule": "Current tab or view is not progression data."
    },
    {
      "id": "site-index-view",
      "inventoryPatterns": [
        "baselineIndexActiveView"
      ],
      "knownKeys": [
        "baselineIndexActiveView"
      ],
      "classification": "session-ui-state",
      "decision": "expire-with-session",
      "target": null,
      "cutoverRule": "Do not persist as account data."
    },
    {
      "id": "local-account-preview-users",
      "inventoryPatterns": [],
      "knownKeys": [
        "__bl_local_users_v1__"
      ],
      "classification": "file-preview-auth-fallback",
      "decision": "exclude-and-retire-in-production",
      "target": null,
      "cutoverRule": "Never migrate browser-stored password material or treat this preview fallback as an account source."
    },
    {
      "id": "local-account-preview-session",
      "inventoryPatterns": [],
      "knownKeys": [
        "__bl_local_session_v1__"
      ],
      "classification": "file-preview-session-fallback",
      "decision": "exclude-and-retire-in-production",
      "target": null,
      "cutoverRule": "Authenticated server sessions remain authoritative; do not migrate this local preview session."
    },
    {
      "id": "pending-recipe-route",
      "inventoryPatterns": [
        "__baseline_pending_recipe_route_v1__"
      ],
      "knownKeys": [
        "__baseline_pending_recipe_route_v1__"
      ],
      "classification": "session-navigation-state",
      "decision": "expire-with-session",
      "target": null,
      "cutoverRule": "This temporary route handoff exists only while replacing a standalone recipe shell with the complete parent application. Never migrate it to Saved Data."
    },
    {
      "id": "fitness-body-view",
      "inventoryPatterns": [
        "__baseline_fitness_body_view_v1__"
      ],
      "knownKeys": [
        "__baseline_fitness_body_view_v1__"
      ],
      "classification": "session-ui-state",
      "decision": "expire-with-session",
      "target": null,
      "cutoverRule": "This remembers only the selected My Body subtab for the current browser session and is not Fitness account data."
    }
  ]
}
