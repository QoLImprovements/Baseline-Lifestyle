# Hostinger PHP fallback: create `.baseline-private.env` beside public_html,
# copy only the needed names below, quote each value, and set file mode 600.
# Never put production values in this example or commit the private file.
BASELINE_DB_PATH=
BASELINE_SAVED_DATA_PATH=
BASELINE_RUNTIME_PATH=
# Allowed values: sqlite, mirror, saved-data.
# Production transition: sqlite -> mirror -> verify -> saved-data.
# Do not infer the deployed value from this file and do not skip mirror verification.
BASELINE_RESOURCE_AUTHORITY=
BL_SITE_URL=
BL_MAIL_FROM_EMAIL=
BL_MAIL_FROM_NAME=
BL_GOOGLE_CLIENT_ID=
BL_GOOGLE_CLIENT_SECRET=
BL_GOOGLE_REDIRECT_URI=
BL_CHARITY_SHOP_PIN=
BL_BADMINTON_MODERATOR_ALIASES=
BL_BADMINTON_DEVELOPER_UID=
BL_BADMINTON_DEVELOPER_NAME=
BL_BADMINTON_DEVELOPER_EMAIL=

# Legacy Fitness voice service only. The offline prototype does not use this.
OPENAI_API_KEY=
BL_VOICE_SAFETY_SALT=
