{
  "formatVersion": 1,
  "authority": "SQLite remains authoritative until an approved resource cutover",
  "rules": [
    {
      "id": "badminton-shared-v3-legacy",
      "inventoryPatterns": ["__baseline_badminton_session_v3__"],
      "knownKeys": ["__baseline_badminton_session_v3__"],
      "classification": "legacy-shared-state",
      "decision": "normalise-and-compare",
      "target": "Shared/badminton-session.json",
      "cutoverRule": "Import only through the protected Badminton administrator path. Compare with the current server state and never let a browser copy silently overwrite a newer shared revision."
    },
    {
      "id": "badminton-shared-v4-cache",
      "inventoryPatterns": ["__baseline_badminton_session_v4__"],
      "knownKeys": ["__baseline_badminton_session_v4__"],
      "classification": "shared-state-browser-cache",
      "decision": "retain-as-non-authoritative-cache-until-cutover",
      "target": "Shared/badminton-session.json",
      "cutoverRule": "The protected server resource is authoritative. Clear or refresh the local cache only after a verified server load; enforce Badminton administration permissions."
    },
    {
      "id": "diet-log-local-content",
      "inventoryPatterns": ["__baseline_food_diet_log_v1__"],
      "knownKeys": ["__baseline_food_diet_log_v1__"],
      "classification": "user-content-without-approved-resource",
      "decision": "preserve-local-and-block-retirement",
      "target": null,
      "cutoverRule": "Contains dated food logs, notes, recipes and health-profile fields. Do not delete or force it into fitness.json. A dedicated schema and explicit approval are required first."
    },
    {
      "id": "outer-embed-snapshot",
      "inventoryPatterns": ["__baseline_outer_embed_snapshot_v2__"],
      "knownKeys": ["__baseline_outer_embed_snapshot_v2__"],
      "classification": "ephemeral-navigation-snapshot",
      "decision": "retire-without-migration",
      "target": null,
      "cutoverRule": "Deletion-only compatibility state. It is not user content and must not become permanent Saved Data."
    },
    {
      "id": "voice-settings",
      "inventoryPatterns": ["__baseline_voice_settings_v1__"],
      "knownKeys": ["__baseline_voice_settings_v1__"],
      "classification": "user-settings",
      "decision": "migrate-authenticated-value",
      "target": "Users/{userId}/voice.json",
      "cutoverRule": "Use the authenticated server voice_settings record when present. Keep guest settings local and never let guest data overwrite an authenticated resource."
    },
    {
      "id": "badminton-focused-game",
      "inventoryPatterns": ["__bl_badminton_focused_v1__"],
      "knownKeys": ["__bl_badminton_focused_v1__"],
      "classification": "individual-game-save",
      "decision": "migrate-explicitly",
      "target": "Users/{userId}/Games/badminton-focused.json",
      "cutoverRule": "Import a local/guest profile only through an explicit signed-in migration and only when it will not overwrite a newer authenticated save."
    },
    {
      "id": "darts-focused-game",
      "inventoryPatterns": ["__bl_darts_focused_v1__", "__bl_darts_focused_v2__"],
      "knownKeys": ["__bl_darts_focused_v1__", "__bl_darts_focused_v2__"],
      "classification": "individual-game-save-with-duplicate-legacy-key",
      "decision": "normalise-and-migrate-explicitly",
      "target": "Users/{userId}/Games/darts-focused.json",
      "cutoverRule": "Treat v1 as the current primary and v2 as the compatibility copy. Report a conflict if their payloads differ; do not choose silently."
    },
    {
      "id": "games-auto-next-preference",
      "inventoryPatterns": ["__bl_games_auto_next_v1__"],
      "knownKeys": ["__bl_games_auto_next_v1__"],
      "classification": "device-ui-preference",
      "decision": "keep-local",
      "target": null,
      "cutoverRule": "This controls device-specific automatic round progression and is not account progression."
    },
    {
      "id": "games-guest-profiles",
      "inventoryPatterns": ["__bl_games_guest_profiles_v1__"],
      "knownKeys": ["__bl_games_guest_profiles_v1__"],
      "classification": "guest-game-profiles",
      "decision": "offer-explicit-per-game-import",
      "target": "Users/{userId}/Games/{game}.json",
      "cutoverRule": "Split by recognised game ID. Require a signed-in user decision and stale-write comparison; guest data must never automatically replace authenticated progress."
    },
    {
      "id": "trackcoin-game",
      "inventoryPatterns": ["__bl_trackcoin_v1__"],
      "knownKeys": ["__bl_trackcoin_v1__"],
      "classification": "individual-game-save",
      "decision": "migrate-explicitly",
      "target": "Users/{userId}/Games/trackcoin.json",
      "cutoverRule": "Prefer an existing authenticated Games Hub profile. Import local data only after recognised-resource validation and conflict review."
    },
    {
      "id": "recipe-title-index",
      "inventoryPatterns": ["[expression] 'bl_recipe_index_' + appKey"],
      "knownKeys": ["bl_recipe_index_{app}"],
      "classification": "rebuildable-display-cache",
      "decision": "rebuild-without-migration",
      "target": null,
      "cutoverRule": "Recipe titles are regenerated from page content and are not the favourites authority."
    },
    {
      "id": "fitness-body-profile",
      "inventoryPatterns": ["[expression] bodyProfileKey("],
      "knownKeys": ["__bl_fitness_body_profile_v1__::{normalised-user}"],
      "classification": "fitness-user-data",
      "decision": "migrate-after-schema-validation",
      "target": "Users/{userId}/fitness.json#bodyProfile",
      "cutoverRule": "Validate field allowlists and units. Do not create paths from the username embedded in the legacy key."
    },
    {
      "id": "storage-wrapper-implementation",
      "inventoryPatterns": ["[expression] key"],
      "knownKeys": [],
      "classification": "implementation-only",
      "decision": "no-independent-migration",
      "target": null,
      "cutoverRule": "Generic wrapper calls are accounted for by the concrete keys passed into them."
    },
    {
      "id": "realm-exploration-game",
      "inventoryPatterns": ["[expression] SAVE_KEY"],
      "knownKeys": ["baseline.realm.exploration.jrpg.v1"],
      "classification": "individual-game-save",
      "decision": "migrate-explicitly",
      "target": "Users/{userId}/Games/baseline-realm-exploration.json",
      "cutoverRule": "Validate the JRPG save version and shared-inventory interactions before importing."
    },
    {
      "id": "skincare-slider-settings",
      "inventoryPatterns": ["[expression] sliderSaveStorageKey(saveId", "[expression] sliderSaveStorageKey(saveKey"],
      "knownKeys": ["__baseline_slider_state__::{normalised-user}::{recipe-or-variant}"],
      "classification": "user-settings-without-approved-resource",
      "decision": "preserve-local-and-block-retirement",
      "target": null,
      "cutoverRule": "These are authenticated recipe-controller preferences, but the approved Saved Data tree has no skincare resource. Keep them local until a protected schema is separately approved."
    },
    {
      "id": "fitness-active-workout",
      "inventoryPatterns": ["[expression] stepStorageKey(current.planId"],
      "knownKeys": ["__bl_fitness_workout_progress_v2__::{planId}::{sessionIndex}::{normalised-user}"],
      "classification": "fitness-active-session-state",
      "decision": "migrate-only-valid-current-session",
      "target": "Users/{userId}/fitness.json#activeWorkout",
      "cutoverRule": "Import only when plan ID, next session and step count match authoritative Fitness data. Invalid/stale entries must be reported, not silently applied."
    },
    {
      "id": "fitness-plan-cache",
      "inventoryPatterns": ["[expression] userCacheKey("],
      "knownKeys": ["__bl_fitness_plan_cache_v1__::{normalised-user}"],
      "classification": "rebuildable-server-cache",
      "decision": "rebuild-without-migration",
      "target": null,
      "cutoverRule": "The server plan is authoritative; this cache may only accelerate display and must be replaced after a verified authoritative read."
    },
    {
      "id": "fitness-file-protocol-plan",
      "inventoryPatterns": ["[expression] userPlanKey("],
      "knownKeys": ["__bl_fitness_plan_v1__::{normalised-user}"],
      "classification": "file-protocol-development-fallback",
      "decision": "exclude-from-production-migration",
      "target": null,
      "cutoverRule": "Production uses the Fitness API. This fallback must not compete with SQLite or JSON authority."
    },
    {
      "id": "realm-tactical-v1-legacy",
      "inventoryPatterns": ["baseline-realm:tactical-operations:v1"],
      "knownKeys": ["baseline-realm:tactical-operations:v1"],
      "classification": "legacy-individual-game-save",
      "decision": "normalise-then-retire",
      "target": "Users/{userId}/Games/baseline-realm-tactical-operations.json",
      "cutoverRule": "Use only when no valid newer v2/inventory-service save exists. Remove after a verified import."
    },
    {
      "id": "realm-tactical-v2",
      "inventoryPatterns": ["baseline-realm:tactical-operations:v2"],
      "knownKeys": ["baseline-realm:tactical-operations:v2"],
      "classification": "individual-game-save-and-local-fallback",
      "decision": "migrate-explicitly",
      "target": "Users/{userId}/Games/baseline-realm-tactical-operations.json",
      "cutoverRule": "Compare with the Baseline Realm inventory-service copy and report divergence before choosing a source."
    },
    {
      "id": "games-hub-view",
      "inventoryPatterns": ["baselineGamesHubView"],
      "knownKeys": ["baselineGamesHubView"],
      "classification": "device-ui-state",
      "decision": "keep-local-or-session-only",
      "target": null,
      "cutoverRule": "Current tab/view is not progression data."
    },
    {
      "id": "site-index-view",
      "inventoryPatterns": ["baselineIndexActiveView"],
      "knownKeys": ["baselineIndexActiveView"],
      "classification": "session-ui-state",
      "decision": "expire-with-session",
      "target": null,
      "cutoverRule": "Do not persist as account data."
    },
    {
      "id": "local-account-preview-users",
      "inventoryPatterns": [],
      "knownKeys": ["__bl_local_users_v1__"],
      "classification": "file-preview-auth-fallback",
      "decision": "exclude-and-retire-in-production",
      "target": null,
      "cutoverRule": "Never migrate browser-stored password material or treat this preview fallback as an account source."
    },
    {
      "id": "local-account-preview-session",
      "inventoryPatterns": [],
      "knownKeys": ["__bl_local_session_v1__"],
      "classification": "file-preview-session-fallback",
      "decision": "exclude-and-retire-in-production",
      "target": null,
      "cutoverRule": "Authenticated server sessions remain authoritative; do not migrate this local preview session."
    }
  ]
}
