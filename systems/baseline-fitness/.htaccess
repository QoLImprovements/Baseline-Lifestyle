# Baseline Fitness runtime delivery: bypass stale HTML/JS caches and inline the
# current voice engine, fitness controller and fitness voice adapter.
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews
  RewriteRule ^baseline-fitness\.html$ baseline-fitness-runtime.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <Files "baseline-fitness-runtime.php">
    Header always unset ETag
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
    Header always set Permissions-Policy "microphone=(self)"
  </Files>
</IfModule>
