# Baseline Lifestyle Apache/Hostinger cache policy
# HTML/PHP never cache. JavaScript and CSS must revalidate because filenames are not content hashes.
# Images and fonts may cache immutably because their URLs are versioned or content-stable.

FileETag None

# Compress text responses while leaving already-compressed media untouched.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType application/x-httpd-php "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# One-time cache upgrade for every public Baseline Recreation route and the physical fallback path.
# The epoch cookie prevents Clear-Site-Data from running on every later visit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/(?:baseline-recreation(?:/.*)?|systems/baseline-recreation/baseline-recreation\.html)/?$ [NC]
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)baseline_games_runtime_epoch=20260629_3(?:;|$) [NC]
  RewriteRule ^ - [E=baseline_games_cache_upgrade:1]
</IfModule>

<IfModule mod_headers.c>
  Header unset ETag
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
  <FilesMatch "\.(html?|php)$">
    Header always unset ETag
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs)$">
    Header always unset ETag
    Header always set Cache-Control "public, max-age=0, must-revalidate"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|woff2?)$">
    Header always unset ETag
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set Clear-Site-Data "\"cache\"" env=baseline_games_cache_upgrade
  Header always set Clear-Site-Data "\"cache\"" env=REDIRECT_baseline_games_cache_upgrade
  Header always add Set-Cookie "baseline_games_runtime_epoch=20260629_3; Path=/; Max-Age=31536000; Secure; SameSite=Lax" env=baseline_games_cache_upgrade
  Header always add Set-Cookie "baseline_games_runtime_epoch=20260629_3; Path=/; Max-Age=31536000; Secure; SameSite=Lax" env=REDIRECT_baseline_games_cache_upgrade
</IfModule>


# CLEAN-DEPLOY-SAFETY-20260526cleanroot
Options -Indexes
<FilesMatch "\.(sqlite|db|env|ini|log|bak|old|zip)$">
  Require all denied
</FilesMatch>


# BASELINE-RECIPE-PATH-URLS-20260527
# Allows URLs such as /baseline-natural-skincare.html/anhydrous-massage-oil-blend
# while still serving the underlying static HTML file.
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # Assets requested relative to a path-style recipe URL should resolve to root assets.
  RewriteRule ^baseline-(natural-skincare|food-approach)\.html/(css|js|game-art|api)/(.*)$ $2/$3 [L,QSA]

  # Page links clicked from a path-style recipe URL should resolve to the real root page.
  RewriteRule ^baseline-(natural-skincare|food-approach)\.html/(index\.html|baseline-[^/]+\.html)$ $2 [R=302,L]

  # Recipe slug routes.
  RewriteRule ^baseline-natural-skincare\.html/([^/]+)/?$ /baseline-natural-skincare/recipes/$1 [R=302,L]
  RewriteRule ^baseline-food-approach\.html/([^/]+)/?$ /baseline-food-approach/recipes/$1 [R=302,L]
</IfModule>

# BASELINE-HOME-INDEX-CANONICAL-20260607
# The public home URL is /home/1, not /index.html or /index.html#tab=system.
# THE_REQUEST prevents internal /home/1 -> index.html rewrites from looping.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ /home/1 [R=302,L]

  RewriteCond %{THE_REQUEST} \s+/[?\s] [NC]
  RewriteRule ^$ /home/1 [R=302,L]
</IfModule>

# BASELINE-SYSTEMS-FOLDER-RESTRUCTURE-20260607
# Section-owned folders now live under /systems/.
# Public URLs remain unchanged: /baseline-food-approach/system, /baseline-games-hub/games-hub, etc.
# Rewrite targets point to systems/<section>/...

# BASELINE-STAGE-3-ASSET-ACCOUNTABILITY-20260607
# Static assets now live with their accountable owner.
# Root legacy /css, /js, /api, and /game-art requests are internally routed to the new structure.
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # Legacy root CSS compatibility.
  RewriteRule ^css/baseline-badminton-session\.css$ systems/baseline-badminton-session/css/baseline-badminton-session.css [L,QSA]
  RewriteRule ^css/baseline-diet-log\.css$ systems/baseline-food-approach/css/baseline-diet-log.css [L,QSA]
  RewriteRule ^css/baseline-games-hub\.css$ systems/baseline-recreation/css/baseline-recreation.css [L,QSA]
  RewriteRule ^css/baseline-recreation\.css$ systems/baseline-recreation/css/baseline-recreation.css [L,QSA]
  RewriteRule ^css/(.*)$ sitewide/css/$1 [L,QSA]

  # Legacy root JS compatibility.
  RewriteRule ^js/baseline-badminton-session\.js$ systems/baseline-badminton-session/js/baseline-badminton-session.js [L,QSA]
  RewriteRule ^js/baseline-diet-food-library\.js$ systems/baseline-food-approach/js/baseline-diet-food-library.js [L,QSA]
  RewriteRule ^js/baseline-diet-log\.js$ systems/baseline-food-approach/js/baseline-diet-log.js [L,QSA]
  RewriteRule ^js/baseline-fitness-app\.js$ systems/baseline-fitness/js/baseline-fitness-app.js [L,QSA]
  RewriteRule ^js/baseline-games-hub\.js$ systems/baseline-recreation/js/baseline-recreation.js [L,QSA]
  RewriteRule ^js/baseline-recreation\.js$ systems/baseline-recreation/js/baseline-recreation.js [L,QSA]
  RewriteRule ^js/(.*)$ sitewide/js/$1 [L,QSA]

  # Legacy API and game-art compatibility.
  # System-owned API compatibility.
  # Fitness API compatibility.
  RewriteRule ^api/achievements\.php$ systems/baseline-fitness/api/achievements.php [L,QSA]
  RewriteRule ^sitewide/api/achievements\.php$ systems/baseline-fitness/api/achievements.php [L,QSA]
  RewriteRule ^api/get_plan\.php$ systems/baseline-fitness/api/get_plan.php [L,QSA]
  RewriteRule ^sitewide/api/get_plan\.php$ systems/baseline-fitness/api/get_plan.php [L,QSA]
  RewriteRule ^api/list_profiles\.php$ systems/baseline-fitness/api/list_profiles.php [L,QSA]
  RewriteRule ^sitewide/api/list_profiles\.php$ systems/baseline-fitness/api/list_profiles.php [L,QSA]
  RewriteRule ^api/plan_update\.php$ systems/baseline-fitness/api/plan_update.php [L,QSA]
  RewriteRule ^sitewide/api/plan_update\.php$ systems/baseline-fitness/api/plan_update.php [L,QSA]
  RewriteRule ^api/save_plan\.php$ systems/baseline-fitness/api/save_plan.php [L,QSA]
  RewriteRule ^sitewide/api/save_plan\.php$ systems/baseline-fitness/api/save_plan.php [L,QSA]
  RewriteRule ^api/update_session\.php$ systems/baseline-fitness/api/update_session.php [L,QSA]
  RewriteRule ^sitewide/api/update_session\.php$ systems/baseline-fitness/api/update_session.php [L,QSA]
  RewriteRule ^api/badminton_logins\.php$ systems/baseline-badminton-session/api/badminton_logins.php [L,QSA]
  RewriteRule ^api/badminton_session\.php$ systems/baseline-badminton-session/api/badminton_session.php [L,QSA]
  RewriteRule ^api/games_profile\.php$ systems/baseline-recreation/api/games_profile.php [L,QSA]
  RewriteRule ^sitewide/api/badminton_logins\.php$ systems/baseline-badminton-session/api/badminton_logins.php [L,QSA]
  RewriteRule ^sitewide/api/badminton_session\.php$ systems/baseline-badminton-session/api/badminton_session.php [L,QSA]
  RewriteRule ^sitewide/api/games_profile\.php$ systems/baseline-recreation/api/games_profile.php [L,QSA]
  RewriteRule ^api/(.*)$ sitewide/api/$1 [L,QSA]
  RewriteRule ^game-art/(.*)$ systems/baseline-recreation/games/baseline-realm/game-art/$1 [L,QSA]
</IfModule>

# BASELINE-PHASE-2-REDIRECT-LOOP-FIX-20260607
# Fixes ERR_TOO_MANY_REDIRECTS after moving main HTML files into section folders.
# Cause: internal clean-route rewrites were being caught by the nested static-file recovery redirects.

# BASELINE-PSYCHOLOGY-PROTECTED-SOURCE-20261016
# The clean Psychology routes are session-guarded through PHP. Do not allow
# direct browser requests to bypass that guard by loading the source HTML.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+systems/baseline-psychology/baseline-psychology\.html[?\s] [NC]
  RewriteRule ^systems/baseline-psychology/baseline-psychology\.html$ /home/1?protected=locked [R=302,L,NE]
</IfModule>

# BASELINE-PHASE-2-MOVED-MAIN-HTML-20260607
# Main section HTML files now live inside accountable section folders.
# Public URLs stay clean; old flat .html requests redirect to the clean section route.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+baseline-food-approach\.html[?\s] [NC]
  RewriteRule ^baseline-food-approach\.html$ /baseline-food-approach/system [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-massage\.html[?\s] [NC]
  RewriteRule ^baseline-massage\.html$ /baseline-massage/system [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-natural-skincare\.html[?\s] [NC]
  RewriteRule ^baseline-natural-skincare\.html$ /baseline-natural-skincare/system [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-psychology\.html[?\s] [NC]
  RewriteRule ^baseline-psychology\.html$ /baseline-psychology/system [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-badminton-session\.html[?\s] [NC]
  RewriteRule ^baseline-badminton-session\.html$ /baseline-badminton-session/system [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-fitness\.html[?\s] [NC]
  RewriteRule ^baseline-fitness\.html$ /baseline-fitness/system [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-games-hub\.html[?\s] [NC]
  RewriteRule ^baseline-games-hub\.html$ /baseline-recreation/system [R=301,L]
  RewriteRule ^baseline-recreation\.html$ /baseline-recreation/system [R=302,L]
</IfModule>

# BASELINE-SKINCARE-LEGACY-RECIPE-CANONICAL-20261006
# Retired recipe slugs redirect before the clean parent-shell rewrite, so the
# browser never paints an obsolete recipe identity and JavaScript never has to
# correct the URL after load.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^baseline-natural-skincare/recipes/(?:hydrating-conductive-mist|testing-microcurrent-conductive-gel)/?$ /baseline-natural-skincare/recipes/microcurrent-glide-gel [R=301,L,NE]
  RewriteRule ^baseline-natural-skincare/recipes/testing-shaving-gel/?$ /baseline-natural-skincare/recipes/calming-shave-gel [R=301,L,NE]
  RewriteRule ^baseline-natural-skincare/recipes/testing-natural-tooth-brightening-powder/?$ /baseline-natural-skincare/recipes/tooth-polishing-powder [R=301,L,NE]
  RewriteRule ^baseline-natural-skincare/recipes/testing-lip-balm/?$ /baseline-natural-skincare/recipes/comfort-barrier-balm [R=301,L,NE]
</IfModule>

# BASELINE-FOOD-RECIPE-SOURCE-CANONICAL-20261004
# Direct requests for physical Food recipe source files canonicalise to the
# public clean recipe URL. Public clean URLs themselves use the Food system shell.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+baseline-food-approach/recipes/([^?\s]+)\.html[?\s] [NC]
  RewriteRule ^baseline-food-approach/recipes/([^/]+)\.html$ /baseline-food-approach/recipes/$1 [R=302,L]
</IfModule>

# BASELINE-MASSAGE-CANONICAL-ROUTES-20260711
# Earlier builds exposed longer tab slugs. Redirect direct browser requests to
# the current concise routes, while internal rewrites remain untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+baseline-massage/types-of-massage(?:[/?\s]) [NC]
  RewriteRule ^baseline-massage/types-of-massage/?$ /baseline-massage/library [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-massage/types(?:[/?\s]) [NC]
  RewriteRule ^baseline-massage/types/?$ /baseline-massage/library [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-massage/massage-library(?:[/?\s]) [NC]
  RewriteRule ^baseline-massage/massage-library/?$ /baseline-massage/library [R=302,L]

  RewriteCond %{THE_REQUEST} \s/+baseline-massage/plan-my-massage(?:[/?\s]) [NC]
  RewriteRule ^baseline-massage/plan-my-massage/?$ /baseline-massage/planner [R=302,L]
</IfModule>

# BASELINE-SAFE-NAMED-ROUTES-20260607
# Clean route support. These routes serve the existing static HTML files;
# files are not renamed, moved, or swapped.
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # Clean Home routes.
  RewriteRule ^home/?$ /home/1 [R=302,L]
  RewriteRule ^home/1/?$ index.html [L,QSA]
  RewriteRule ^home/2/?$ index.html [L,QSA]

  # Page defaults.
  RewriteRule ^baseline-food-approach/?$ /baseline-food-approach/system [R=302,L]
  RewriteRule ^baseline-massage/?$ /baseline-massage/system [R=302,L]
  RewriteRule ^baseline-natural-skincare/?$ /baseline-natural-skincare/system [R=302,L]
  RewriteRule ^baseline-psychology/?$ /baseline-psychology/system [R=302,L]
  RewriteRule ^baseline-badminton-session/?$ /baseline-badminton-session/system [R=302,L]
  RewriteRule ^baseline-fitness/?$ /baseline-fitness/system [R=302,L]
  RewriteRule ^baseline-recreation/?$ /baseline-recreation/system [R=302,L]
  RewriteRule ^baseline-games-hub/?$ /baseline-recreation/system [R=301,L,NE]

  # If a browser ever creates a bad nested static-file URL, recover to the clean route.
  # THE_REQUEST prevents internal Phase 2 rewrites from being redirected again.
  RewriteCond %{THE_REQUEST} \s/+[^\s]*index\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/index\.html$ /home/1 [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-food-approach\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-food-approach\.html$ /baseline-food-approach/system [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-massage\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-massage\.html$ /baseline-massage/system [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-natural-skincare\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-natural-skincare\.html$ /baseline-natural-skincare/system [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-psychology\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-psychology\.html$ /baseline-psychology/system [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-badminton-session\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-badminton-session\.html$ /baseline-badminton-session/system [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-fitness\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-fitness\.html$ /baseline-fitness/system [R=302,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-games-hub\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-games-hub\.html$ /baseline-recreation/system [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s]*baseline-recreation\.html[?\s] [NC]
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/baseline-recreation\.html$ /baseline-recreation/system [R=302,L]

  # Assets requested from clean-route folders resolve to the real root folders.
  RewriteRule ^(?:home|baseline-[^/]+)(?:/[^/]+)*/(css|js|game-art|api)/(.*)$ $1/$2 [L,QSA]

  # BASELINE-CLEAN-CONTENT-RECORD-ROUTES-20260616
  # Fine-detail Food and Skincare records now have file ownership.
  RewriteRule ^baseline-food-approach/ingredients/mushrooms/?$ /baseline-food-approach/ingredient-library/white-mushroom [R=302,L]
  RewriteRule ^baseline-food-approach/ingredients/([^/]+)/?$ /baseline-food-approach/ingredient-library/$1 [R=302,L]
  RewriteRule ^baseline-food-approach/ingredient-library/([^/]+)/?$ systems/baseline-food-approach/ingredients/$1.html [L,QSA]
  # Legacy skincare ingredient aliases now resolve to one canonical record each.
  RewriteRule ^baseline-natural-skincare/ingredient-library/castor/?$ /baseline-natural-skincare/ingredient-library/castor-oil [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/cucumber/?$ /baseline-natural-skincare/ingredient-library/cucumber-seed-oil [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/jojoba/?$ /baseline-natural-skincare/ingredient-library/jojoba-oil [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/shea/?$ /baseline-natural-skincare/ingredient-library/shea-butter [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/lavender-essential-oil/?$ /baseline-natural-skincare/ingredient-library/lavender [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/olive-oil/?$ /baseline-natural-skincare/ingredient-library/olive [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/rose-water/?$ /baseline-natural-skincare/ingredient-library/rosewater [R=302,L]
  RewriteRule ^baseline-natural-skincare/ingredient-library/safflower-oil/?$ /baseline-natural-skincare/ingredient-library/safflower [R=302,L]
  # Canonical Skincare ingredient detail URLs keep the full application shell.
  # The client router selects and scrolls to the matching ingredient card.
  RewriteRule ^baseline-natural-skincare/ingredient-library/([^/]+)/?$ systems/baseline-natural-skincare/baseline-natural-skincare.html [L,QSA]
  RewriteRule ^baseline-food-approach/diet-log/([^/]+)/?$ "systems/baseline-food-approach/Diet Log/$1.html" [L,QSA]

  # BASELINE-CLEAN-RECIPE-DETAIL-ROUTES-20261004
  # Food and Skincare share the same shell-first recipe architecture.
  # Clean detail routes keep their system shell; canonical recipe sources feed
  # the shared recipe runtime instead of becoming separate page experiences.
  RewriteRule ^baseline-food-approach/recipes/([^/]+)/?$ systems/baseline-food-approach/baseline-food-approach.html [L,QSA]
  RewriteRule ^baseline-natural-skincare/recipes/testing-lip-balm/?$ /baseline-natural-skincare/recipes/comfort-barrier-balm [R=301,L]
  RewriteRule ^baseline-natural-skincare/recipes/([^/]+)/?$ systems/baseline-natural-skincare/baseline-natural-skincare.html [L,QSA]

  # Baseline Charity Shop uses the same virtual clean-route structure as every other system.
  RewriteRule ^charity-shop/guidance/?$ /baseline-charity-shop/guidance [R=301,L]
  RewriteRule ^baseline-charity-shop/guidance/?$ systems/charity-shop/charity-shop.php [L,QSA]

  # Standard page tab routes.
  RewriteRule ^baseline-food-approach/(system|recipes|ingredient-library|diet-log)/?$ systems/baseline-food-approach/baseline-food-approach.html [L,QSA]

  # Baseline Massage uses the concise public routes selected by its tabs.
  # These are handled here at the site root because /baseline-massage/* is a
  # virtual public path; the physical app lives under /systems/.
  RewriteRule ^baseline-massage/(system|library|planner)/?$ systems/baseline-massage/baseline-massage.html [L,QSA]

  RewriteRule ^baseline-natural-skincare/(system|recipes|ingredient-library|skin-support-system|my-routine)/?$ systems/baseline-natural-skincare/baseline-natural-skincare.html [L,QSA]
  RewriteRule ^baseline-psychology/(system|paralinguistics)/?$ systems/baseline-psychology/baseline-psychology.php [L,QSA]
  RewriteRule ^baseline-badminton-session/(system|game-plan|ratings-standings|players-pairs|session-history)/?$ systems/baseline-badminton-session/baseline-badminton-session.html [L,QSA]
  # Recover malformed top-level Fitness URLs produced by the former nested route builder.
  RewriteRule ^baseline-fitness/my-routine(?:/(?:log|summary|public|plan(?:/(?:calisthenics|cardio|other|sports))?))?/(system|my-plan|my-body|library|exercise-library|achievements)/?$ /baseline-fitness/$1 [R=302,L]

  RewriteRule ^baseline-fitness/(system|workout-routine|library|exercise-library|achievements|my-plan|my-body)/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]
  RewriteRule ^baseline-fitness/my-plan/(completed|future)/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]
  RewriteRule ^baseline-fitness/my-body/(profile|services)/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]

  # Baseline Recreation canonical hierarchy.
  # Legacy Games Hub public URLs are compatibility redirects only.
  RewriteRule ^baseline-games-hub/games-hub/games-list/?$ /baseline-recreation/games [R=301,L,NE]
  RewriteRule ^baseline-games-hub/games-hub/puzzles/?$ /baseline-recreation/puzzles [R=301,L,NE]
  RewriteRule ^baseline-games-hub/games-hub/(pairs|detect-the-word|make-the-number|track-the-coin|rule-shift|block-grid|colour-sort|darts-focused|badminton-focused|baseline-realm)/?$ /baseline-recreation/games/$1 [R=301,L,NE]
  RewriteRule ^baseline-games-hub(?:/games-hub)?/?$ /baseline-recreation/system [R=301,L,NE]

  RewriteRule ^baseline-recreation/(system|games|puzzles)/?$ systems/baseline-recreation/baseline-recreation.html [L,QSA]
  RewriteRule ^baseline-recreation/games/(pairs|detect-the-word|make-the-number|track-the-coin|rule-shift|block-grid|colour-sort|darts-focused|badminton-focused|baseline-realm)/?$ systems/baseline-recreation/baseline-recreation.html [L,QSA]
  RewriteRule ^baseline-recreation/puzzles/(jigsaws|crossnumber)/?$ systems/baseline-recreation/baseline-recreation.html [L,QSA]
  RewriteRule ^baseline-recreation/puzzles/jigsaws/[^/]+/?$ systems/baseline-recreation/baseline-recreation.html [L,QSA]

  # Legacy physical paths map to the migrated physical hierarchy.
  RewriteRule ^systems/baseline-games-hub/baseline-games-hub\.html$ /baseline-recreation/system [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/css/baseline-games-hub\.css$ /systems/baseline-recreation/css/baseline-recreation.css [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/css/games-hub-theme\.css$ /systems/baseline-recreation/css/recreation-theme.css [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/js/baseline-games-hub-core\.js$ /systems/baseline-recreation/js/baseline-recreation-core.js [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/js/baseline-games-hub-guard\.js$ /systems/baseline-recreation/js/baseline-recreation-guard.js [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/js/baseline-games-hub-v14\.js$ /systems/baseline-recreation/js/baseline-recreation-loader.js [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/js/baseline-games-hub\.js$ /systems/baseline-recreation/js/baseline-recreation.js [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/js/games-hub-modal\.js$ /systems/baseline-recreation/js/games-help-modal.js [R=301,L,NE]
  RewriteRule ^systems/baseline-games-hub/(.*)$ /systems/baseline-recreation/$1 [R=301,L,NE]
</IfModule>

# BASELINE-MY-ROUTINE-CLEAN-ROUTES-20260810
# My Routine uses readable page paths. Filters, dates and other transient UI state
# stay client-side/session-side and are not exposed as query-string instructions.
# Bare /my-routine is served without a forced redirect so the client can migrate
# an existing remembered subview (for example an old Summary session) once, then
# replace the address with its canonical clean subroute.
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # Fitness bare route plus clean pages / Plan subtabs.
  RewriteRule ^baseline-fitness/my-routine/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]
  RewriteRule ^baseline-fitness/my-routine/(log|summary|public)/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]
  RewriteRule ^baseline-fitness/my-routine/plan/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]
  RewriteRule ^baseline-fitness/my-routine/plan/(calisthenics|cardio|other|sports)/?$ systems/baseline-fitness/baseline-fitness.html [L,QSA]

  # Skincare nested My Routine pages. The bare route is already served by the
  # standard Skincare tab rule above and is migrated client-side the same way.
  RewriteRule ^baseline-natural-skincare/my-routine/(log|summary|plan|public)/?$ systems/baseline-natural-skincare/baseline-natural-skincare.html [L,QSA]
</IfModule>
